% =============================================================================
% Example references.bib
% =============================================================================
% Full guide: https://www.bibtex.com/format/
% Use BibTeX keys that are unique and descriptive: AuthorYearKeyword
% =============================================================================

% --- Article (journal paper) ---
@article{Key2025Example,
  author    = {First Author and Second Author and Third Author},
  title     = {Title of the Research Paper},
  journal   = {Journal Name},
  year      = {2025},
  volume    = {10},
  number    = {2},
  pages     = {100--120},
  doi       = {10.1000/example.doi},
  url       = {https://doi.org/example},
}

% --- InProceedings (conference paper) ---
@inproceedings{Key2024Conference,
  author    = {First Author and Second Author},
  title     = {Conference Paper Title},
  booktitle = {Proceedings of the International Conference on ...},
  year      = {2024},
  pages     = {1--12},
  publisher = {IEEE},
  doi       = {10.1000/conf.example},
}

% --- Book ---
@book{Key2023Book,
  author    = {Author Name},
  title     = {Book Title},
  publisher = {Publisher Name},
  year      = {2023},
  edition   = {2},
  isbn      = {978-0-000-00000-0},
}

% --- InBook (chapter in a book) ---
@inbook{Key2022Chapter,
  author    = {Chapter Author},
  title     = {Chapter Title},
  booktitle = {Book Title},
  editor    = {Editor Name},
  publisher = {Publisher},
  year      = {2022},
  chapter   = {5},
  pages     = {100--150},
}

% --- Technical Report ---
@techreport{Key2021Report,
  author      = {Author Name},
  title       = {Technical Report Title},
  institution = {Institution Name},
  year        = {2021},
  number      = {TR-2021-001},
}

% --- PhD Thesis ---
@phdthesis{Key2020Thesis,
  author  = {Author Name},
  title   = {Thesis Title},
  school  = {University Name},
  year    = {2020},
}

% --- Misc (webpage, software, etc.) ---
@misc{Key2024Software,
  author       = {Author Name},
  title        = {Software/Repository Name},
  year         = {2024},
  howpublished = {\url{https://github.com/user/repo}},
  note         = {Version 1.0},
}

% --- arXiv preprint ---
@misc{Key2024Arxiv,
  author       = {First Author and Second Author},
  title        = {Preprint Title},
  year         = {2024},
  eprint       = {2401.00000},
  archiveprefix = {arXiv},
  primaryclass = {cs.AI},
}
