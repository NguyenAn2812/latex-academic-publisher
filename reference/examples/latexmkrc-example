#!/usr/bin/env perl
# .latexmkrc - LaTeX compilation configuration
# Place this file in the project root as .latexmkrc

# --- Output format ---
$pdf_mode = 1;              # 1 = pdflatex, 2 = ps2pdf, 3 = dvipdf
$postscript_mode = 0;
$dvi_mode = 0;

# --- Bibliography ---
$bibtex_use = 2;            # 0 = no bibtex, 1 = bibtex, 2 = biber
$biber = "biber %O %S";

# --- Output directory ---
$out_dir = "build";

# --- Cleanup ---
$clean_ext = "bbl bcf run.xml out aux log blg brf fls fdb_latexmk";

# --- Repeat passes ---
$max_repeat = 5;

# --- Silent mode (0 = verbose, 1 = quiet, 2 = silent) ---
$silent = 0;

# --- Force build directory creation ---
push @generated_exts, "build";

